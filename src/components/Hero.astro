---
// src/components/Hero.astro
---

<section class="hero-wrapper">
  <!-- Video Background -->
  <div class="video-container">
    <video 
      class="hero-video" 
      autoplay 
      loop 
      muted 
      playsinline
      src="/hero-video.mp4" 
    ></video>
    <div class="video-overlay"></div>
  </div>

  <!-- Google Labs Glassmorphism Container -->
  <div class="hero-content">
    <div class="glass-card">
      <div class="glass-badge">
        <span class="badge-dot"></span>
        <span>REDEFINING RWANDAN TRAVEL</span>
      </div>

      <h1 class="hero-title">
        <span>Savor the Journey,</span><br/>
        <span class="highlight-text">Not Just the Destination.</span>
      </h1>

      <p class="hero-sub">
        Premium private transit & curated fleet rentals across Kigali and beyond. Elevated comfort tailored to your rhythm.
      </p>

      <div class="hero-actions">
        <a href="#book" class="btn-primary">Reserve Your Ride</a>
        <a href="#fleet" class="btn-secondary">Explore Fleet</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  // GSAP Context for memory safety & clean lifecycle
  let ctx = gsap.context(() => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    // 1. Reveal Glass Container & Subtle Zoom on Video
    tl.from(".glass-card", {
      y: 40,
      opacity: 0,
      duration: 1.2,
      scale: 0.96
    })
    .from(".hero-video", {
      scale: 1.15,
      duration: 2,
      ease: "power2.out"
    }, 0)

    // 2. Animate Badge & Headline Stagger
    .from(".glass-badge", {
      opacity: 0,
      y: -10,
      duration: 0.6
    }, "-=0.8")
    .from(".hero-title span", {
      y: 35,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15
    }, "-=0.6")

    // 3. Subtitle & Buttons
    .from(".hero-sub", {
      opacity: 0,
      y: 20,
      duration: 0.6
    }, "-=0.4")
    .from(".hero-actions a", {
      opacity: 0,
      scale: 0.9,
      duration: 0.5,
      stagger: 0.1
    }, "-=0.3");
  });
</script>

<style>
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0 0 3rem 3rem; /* Modern rounded bottom hero */
  }

  /* Video Background */
  .video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(11, 15, 23, 0.4) 0%, rgba(11, 15, 23, 0.85) 100%);
  }

  /* Glassmorphism Hero Content */
  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 900px;
    padding: 7rem 1.5rem 3rem 1.5rem; /* Top padding leaves space for absolute header */
    display: flex;
    justify-content: center;
  }

  .glass-card {
    width: 100%;
    padding: 3.5rem 3rem;
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .glass-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #e2e8f0;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #fbbf24;
    box-shadow: 0 0 8px #fbbf24;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.1;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .highlight-text {
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    max-width: 600px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    background: #fbbf24;
    color: #0f172a;
    padding: 0.85rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(251, 191, 36, 0.3);
  }

  .btn-primary:hover {
    background: #f59e0b;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(251, 191, 36, 0.45);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    padding: 0.85rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .glass-card {
      padding: 2rem 1.25rem;
    }
  }
</style>