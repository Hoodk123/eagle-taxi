---
// src/components/ScrollFeature.astro
---

<section class="spacer">
  <h2>Scroll down to see GSAP in action...</h2>
</section>

<section class="cards-wrapper">
  <div class="card">Card 1</div>
  <div class="card">Card 2</div>
  <div class="card">Card 3</div>
</section>

<section class="spacer">
  <h2>You reached the bottom!</h2>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Use gsap.context() for clean memory cleanup
  let ctx = gsap.context(() => {
    gsap.from(".card", {
      y: 100,
      opacity: 0,
      duration: 1,
      stagger: 0.2,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".cards-wrapper",
        start: "top 75%", // Triggers when top of section hits 75% viewport height
        end: "bottom 20%",
        toggleActions: "play none none reverse", // Plays forward on scroll down, reverses on scroll back up
      },
    });
  });
</script>

<style>
  .spacer {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cards-wrapper {
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding: 4rem 1rem;
  }

  .card {
    width: 200px;
    height: 280px;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: bold;
    color: #38bdf8;
  }
</style>